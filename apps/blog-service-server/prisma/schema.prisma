datasource db {
  provider = "postgresql"
  url      = env("DB_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Comment {
  blog      Blog?    @relation(fields: [blogId], references: [id])
  blogId    String?
  content   String?
  createdAt DateTime @default(now())
  id        String   @id @default(cuid())
  updatedAt DateTime @updatedAt
  user      User?    @relation(fields: [userId], references: [id])
  userId    String?
}

model Blog {
  comments        Comment[]
  createdAt       DateTime  @default(now())
  description     String?
  featureImage    String?
  id              String    @id @default(cuid())
  keyword         String?
  metaDescription String?
  metaTitle       String?
  published       Boolean?
  title           String?
  updatedAt       DateTime  @updatedAt
  user            User?     @relation(fields: [userId], references: [id])
  userId          String?
}

model User {
  blogs     Blog[]
  comments  Comment[]
  createdAt DateTime  @default(now())
  email     String?   @unique
  firstName String?
  id        String    @id @default(cuid())
  lastName  String?
  password  String
  roles     Json
  updatedAt DateTime  @updatedAt
  username  String    @unique
}
